{
  "name": "readease",
  "version": "1.0.0",
  "description": "ReadEase - Assistive Typography & AI Reading Studio",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "web:dev": "npm --prefix frontend run dev",
    "web:build": "npm --prefix frontend run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "node-fetch": "^2.6.9"
  },
  "devDependencies": {
    "nodemon": "^2.0.22"
  }
}
